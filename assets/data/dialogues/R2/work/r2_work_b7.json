   "tags": [],
   "new": []
  },
  {
   "num": 4,
   "speaker": "B",
   "tl": "O bugünkü. Geceki ben değilim, valla.",
   "rd": "오 부귄퀴. 게제키 벤 데일림, 발라.",
   "ko": "이건 오늘 거야. 밤에 먹은 건 나 아니야, 진짜.",
