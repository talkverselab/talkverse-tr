   "tags": [],
   "new": []
  },
  {
   "num": 2,
   "speaker": "B",
   "tl": "Ben değilim! Bana niye bakıyorsunuz?",
   "rd": "벤 데일림! 바나 니예 바크요르수누즈?",
   "ko": "저 아니에요! 왜 저를 보세요?",
   "note": "ben değilim = 나 아니다",
   "tags": [],
   "new": []
  },
  {
   "num": 3,
   "speaker": "A",
   "tl": "Can, ağzında pasta var.",
