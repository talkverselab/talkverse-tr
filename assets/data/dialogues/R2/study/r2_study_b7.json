   "ko": "물어봐. 터키어 늘어야지.",
   "note": "sor = 물어봐",
   "tags": [],
   "new": []
  },
  {
   "num": 3,
   "speaker": "A",
   "tl": "Çok korkuyorum. Yanlış söylerim.",
