   ]
  },
  {
   "num": 4,
   "speaker": "A",
   "tl": "Çok güzel! Limon mu?",
   "rd": "촉 귀젤! 리몬 무?",
   "ko": "너무 좋아요! 레몬이에요?",
   "note": "limon = 레몬",
   "tags": [
