    },
    {
     "tl": "Saat kaçta?",
     "rd": "사아트 카치타?",
     "ko": "몇 시에?"
    }
   ]
  },
  {
   "id": "p10",
   "key": "-di (과거)",
   "label": "~였다",
   "explanation": "과거 어미 -di.",
   "stage": 2,
   "examples": [
    {
     "tl": "Güzeldi.",
     "rd": "귀젤디.",
     "ko": "좋았어."
    },
    {
     "tl": "Film güzeldi.",
     "rd": "필름 귀젤디.",
     "ko": "영화 좋았어."
    },
    {
     "tl": "Dün yorgundum.",
     "rd": "뒨 요르군둠.",
     "ko": "나 어제 피곤했어."
    }
   ]
  }
 ]
